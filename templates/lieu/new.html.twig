{% extends 'base.html.twig' %}

{% block title %}
    Créer un lieu
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h2 class="mb-0">Créer un lieu</h2>
                    </div>

                    <div class="card-body">
                        {{ form_start(form) }}
                        {{ form_row(form.nom) }}
                        {{ form_row(form.rue) }}

                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.latitude) }}</div>
                            <div class="col-md-6">{{ form_row(form.longitude) }}</div>
                        </div>

                        {{ form_row(form.ville) }}

                        <div class="mb-3">
                            <label class="form-label">Choisir un emplacement sur la carte</label>
                            <div id="map-create-lieu" style="height: 400px; border-radius: 10px;"></div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="{{ path('app_lieu_index') }}" class="btn btn-secondary">Retour</a>
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                        </div>

                        {{ form_end(form) }}

                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
