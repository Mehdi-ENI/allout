{% extends 'base.html.twig' %}

{% block title %}Gérer les lieux{% endblock %}

{% block body %}
    <div class="container">

        <h2>Gérer les lieux</h2>

        <h5>Filtrer les lieux</h5>
        <form class="mb-3" method="get" action="{{ path('app_lieu_index') }}">
            <div class="row align-items-center">
                <div class="col-auto">
                    <label for="recherche" class="col-form-label">Le nom contient :</label>
                </div>
                <div class="col-auto">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" id="recherche" class="form-control form-control-sm"
                               name="recherche" placeholder="Rechercher" value="{{ recherche }}">
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-sm my-btn-icone">
                        <i class="bi bi-search"></i> <span>Rechercher</span>
                    </button>
                </div>
                <div class="col-auto ms-auto">
                    <a href="{{ path('app_lieu_new') }}" class="btn btn-primary btn-sm my-btn-icone">
                        <i class="bi bi-plus-circle"></i> <span>Ajouter un lieu</span>
                    </a>
                </div>
            </div>
        </form>

        <div class="border rounded p-3 overflow-x-auto">
            <table class="table table-hover" style="--bs-table-bg: transparent;">
                <thead>
                <tr style="--bs-table-bg: transparent;">
                    <th>Nom</th>
                    <th>Rue</th>
                    <th>Latitude</th>
                    <th>Longitude</th>
                    <th>Ville</th>
                    <th style="width: 1%">Actions</th>
                </tr>
                </thead>
                <tbody class="table-group-divider">
                {% for lieu in lieux %}
                    <tr>
                        <td>{{ lieu.nom }}</td>
                        <td>{{ lieu.rue }}</td>
                        <td>{{ lieu.latitude }}</td>
                        <td>{{ lieu.longitude }}</td>
                        <td>{{ lieu.ville.nom }}</td>
                        <td class="text-nowrap">
                            <a href="{{ path('app_lieu_edit', {'id': lieu.id}) }}"
                               class="btn btn-warning btn-sm my-btn-icone">
                                <i class="bi bi-pencil"></i> <span>Modifier</span>
                            </a>
                            <form method="post" action="{{ path('app_lieu_delete', {'id': lieu.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ lieu.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm my-btn-icone"
                                        onclick="return confirm('Supprimer ce lieu ?')">
                                    <i class="bi bi-trash"></i> <span>Supprimer</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">Aucun résultat trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
{% endblock %}
