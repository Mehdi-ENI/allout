{% extends 'base.html.twig' %}

{% block body %}

    <h3>{{ sortie.nom }}</h3>

    <p>
        <strong>Date :</strong>
        {{ sortie.dateHeureDebut|date('d/m/Y H:i') }}
    </p>

    <p>
        <strong>Lieu :</strong>
        {{ sortie.lieu.nom }}<br>
        {{ sortie.lieu.rue }}<br>
        {{ sortie.lieu.ville.nom }}
    </p>

    <p>
    <strong>Participants :</strong>
    {{ sortie.participants|length }} / {{ sortie.nbInscriptionsMax }}<br>
    {% if sortie.participants|length > 0 %}
        <ul class="list-unstyled mb-0">
            {% for participant in sortie.participants %}
                <li>
                    <a href="{{ path('profile_show', {id: participant.id}) }}">
                        {% if participant.pseudo %}
                            {{ participant.pseudo }}
                        {% else %}
                            {{ participant.nom }} {{ participant.prenom }}
                        {% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <span class="text-muted">Aucun participant inscrit</span>
    {% endif %}


    </p>

    {{ form_start(form) }}
    {{ form_row(form.motif) }}

    <div class="d-flex justify-content-end gap-2">
        <a href="{{ path('sortie_detail', { id: sortie.id }) }}" class="btn btn-secondary">Retour</a>
        <button type="submit" class="btn btn-danger">Annuler la sortie</button>
    </div>

    {{ form_end(form) }}
{% endblock %}

{% block title %}

{% endblock %}

