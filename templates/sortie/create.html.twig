{% extends 'base.html.twig' %}

{% block title %}
    Créer une sortie
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm">

                    <div class="card-header bg-primary text-white">
                        <h2 class="mb-0">Créer une sortie</h2>
                    </div>

                    <div class="card-body">
                        {{ form_start(sortieForm) }}
                        {{ form_row(sortieForm.nom) }}
                        <div class="row">
                            <div class="col-md-6">{{ form_row(sortieForm.dateHeureDebut) }}</div>
                            <div class="col-md-6">{{ form_row(sortieForm.dateLimiteInscription) }}</div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">{{ form_row(sortieForm.duree) }}</div>
                            <div class="col-md-4">{{ form_row(sortieForm.nbInscriptionsMax) }}</div>
                        </div>

                        {{ form_row(sortieForm.infosSortie) }}
{#                        {{ form_row(sortieForm.lieu) }}   ---  remplacé par le formulaire de lieu avec un button de ajout s'il n'existe pas#}

                        <div class="mb-3">
                            {{ form_label(sortieForm.lieu) }}

                            <div class="d-flex gap-2">
                                {{ form_widget(sortieForm.lieu, {'attr': {'class': 'form-select'}}) }}
                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#lieuModal">+</button>
                            </div>

                            {{ form_errors(sortieForm.lieu) }}
                        </div>

                        {{ form_row(sortieForm.site) }}

                        <div class="d-flex justify-content-end gap-2">
                            <a href="{{ path('sortie_list') }}" class="btn btn-secondary">Retour</a>
                            <button type="submit" class="btn btn-primary">Créer</button>
                        </div>

                        {{ form_end(sortieForm) }}

                        <!-- Modale pour ajouter un lieu -->
                        <div class="modal fade" id="lieuModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Ajouter un lieu</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>

                                    {{ form_start(lieuForm, {
                                        'action': path('app_lieu_new'),
                                        'attr': {'id': 'lieu-form'}
                                    })
                                    }}

                                    <div class="modal-body">
                                        {{ form_widget(lieuForm) }}

                                        <div class="mt-3">
                                            <label class="form-label">Choisir sur la carte</label>
                                            <div id="map-create-lieu" style="height: 300px; border-radius: 10px;"></div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                                    </div>

                                    {{ form_end(lieuForm) }}

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/lieu-modal.js') }}"></script>
{% endblock %}
