<turbo-frame id="liste-sorties">
    <table class="table">
        <thead>
        <tr>
            <th>Nom de la sortie</th>
            <th>Date de la sortie</th>
            <th>Clotûre</th>
            <th>Inscrits/places</th>
            <th>État</th>
            <th>Inscrit</th>
            <th>Organisateur</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for sortie in sorties %}
            {% if sortie.etat.value != "annulee" and sortie.etat.value != "archivee" %}
                <tr>
                <td>{{ sortie.nom }}</td>
                <td>{{ sortie.dateHeureDebut|date('Y-m-d H:i') }}</td>
                <td>{{ sortie.dateLimiteInscription|date('Y-m-d') }}</td>
                <td>{{ sortie.participants | length }}/{{ sortie.nbInscriptionsMax }}</td>
                <td>{{ sortie.etat.value }}</td>
                <td>{{ sortie.participants.contains(app.user) ? 'X' : '' }}</td>
                <td>{{ sortie.organisateur.nom | capitalize }} {{ sortie.organisateur.prenom | slice(0, 1) }}.</td>
                <td>
                {% if sortie.etat.value == "creee" and sortie.organisateur == app.user %}
                    <a href="">Afficher</a>
                    <a href="">Modifier</a>
                    <a href="">Publier</a>
                {% endif %}

                {% if sortie.etat.value == "publiee" %}
                    <a href="">Afficher</a>
                    {% if sortie.organisateur == app.user %}
                        <a href="">Annuler</a>
                    {% else %}
                        {% if sortie.participants.contains(app.user) %}
                            <a href="">Se désister</a>
                        {% else %}
                            <a href="">S'inscrire</a>
                        {% endif %}
                    {% endif %}
                {% endif %}

                {% if sortie.etat.value == "cloturee" %}
                    <a href="">Afficher</a>
                {% endif %}




                {#                    <a href="">Afficher</a> #}
                {#                    <a href="">Modifier</a> #}
                {#                    <a href="">Publier</a> #}
                {#                    <a href="">S'inscrire</a> #}
                {#                    <a href="">Se désister</a> #}
                {#                    <a href="">Annuler</a> #}
            {% endif %}
            </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">No records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</turbo-frame>
