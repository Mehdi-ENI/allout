<turbo-frame id="liste-sorties">
    <table class="table">
        <thead>
        <tr>
            <th>Nom de la sortie</th>
            <th>Date de la sortie</th>
            <th>Clotûre</th>
            <th>Inscrits/places</th>
            <th>État</th>
            <th>Inscrit</th>
            <th>Organisateur</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for sortie in sorties %}
            {% if sortie.etat.value != "archivee"
                and (sortie.etat.value != "creee" or sortie.organisateur == app.user)
                and (sortie.etat.value != "annulee" or sortie.organisateur == app.user or sortie.participants.contains(app.user)) %}
                <tr>
                    <td>{{ sortie.nom }}</td>
                    <td>{{ sortie.dateHeureDebut|date('Y-m-d H:i') }}</td>
                    <td>{{ sortie.dateLimiteInscription|date('Y-m-d') }}</td>
                    <td>{{ sortie.participants | length }}/{{ sortie.nbInscriptionsMax }}</td>
                    <td>{{ sortie.etat.value }}</td>
                    <td>{{ sortie.participants.contains(app.user) ? 'X' : '' }}</td>
                    <td>{{ sortie.organisateur.nom | capitalize }} {{ sortie.organisateur.prenom | slice(0, 1) }}.</td>
                    <td>
                        {% if sortie.etat.value == "creee" and sortie.organisateur == app.user %}
                            <a class="btn btn-primary" href="{{ path('sortie_detail', {id: sortie.id}) }}">Afficher</a>
                            <a class="btn btn-warning" href="">Modifier</a>
                            <a class="btn btn-success" href="">Publier</a>

                        {% elseif sortie.etat.value == "publiee" %}
                            <a class="btn btn-primary" href="{{ path('sortie_detail', {id: sortie.id}) }}">Afficher</a>
                            {% if app.user %}
                                {% if sortie.organisateur == app.user %}
                                    <a class="btn btn-danger" href="{{ path('sortie_annuler', {id: sortie.id}) }}">Annuler</a>
                                {% elseif sortie.participants.contains(app.user) %}
                                    <form method="post" action="{{ path('sortie_desistement', {id: sortie.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('desistement' ~ sortie.id) }}">
                                        <button class="btn btn-warning" type="submit">Se désister</button>
                                    </form>
                                {% else %}
                                    <form method="post" action="{{ path('sortie_inscription', {id: sortie.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('inscription' ~ sortie.id) }}">
                                        <button class="btn btn-success" type="submit">S'inscrire</button>
                                    </form>
                                {% endif %}
                            {% endif %}

                        {% elseif sortie.etat.value in ["cloturee", "en_cours", "terminee", "annulee"] %}
                            <a class="btn btn-primary" href="{{ path('sortie_detail', {id: sortie.id}) }}">Afficher</a>
                        {% endif %}
                    </td>
                </tr>
            {% endif %}
        {% else %}
            <tr>
                <td colspan="4">No records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</turbo-frame>
