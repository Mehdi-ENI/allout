<turbo-frame id="liste-sorties">
    <div class="border rounded p-3 overflow-x-auto">
        <table class="table table-hover" style="--bs-table-bg: transparent;">
            <thead>
            <tr class="table" style="--bs-table-bg: transparent;">
                <th scope="col">Nom de la sortie</th>
                <th scope="col">Date de la sortie</th>
                <th scope="col" class="d-none d-sm-table-cell">Clotûre</th>
                <th scope="col" class="d-none d-sm-table-cell">Inscrits/places</th>
                <th scope="col" class="d-none d-sm-table-cell">État</th>
                <th scope="col" class="d-none d-sm-table-cell">Inscrit</th>
                <th scope="col" class="d-none d-sm-table-cell">Organisateur</th>
                <th scope="col" class="d-sm-none">Lieu</th>
                <th scope="col" class="d-none d-sm-table-cell">Actions</th>
            </tr>
            </thead>
            <tbody class="table-group-divider">
            {% for sortie in sorties %}
                {% if sortie.etat.value != "archivee"
                    and (sortie.etat.value != "creee" or sortie.organisateur == app.user)
                    and (sortie.etat.value != "annulee" or sortie.organisateur == app.user or sortie.participants.contains(app.user)) %}
                    <tr>
                        <td class="text-truncate" style="max-width: 150px;"><a href="{{ path('sortie_detail', {id: sortie.id}) }}">{{ sortie.nom }}</a></td>
                        <td>{{ sortie.dateHeureDebut|date('d/m/Y H:i') }}</td>
                        <td class="d-none d-sm-table-cell">{{ sortie.dateLimiteInscription|date('d/m/Y') }}</td>
                        <td class="d-none d-sm-table-cell">{{ sortie.participants | length }}/{{ sortie.nbInscriptionsMax }}</td>
                        <td class="d-none d-sm-table-cell">{{ sortie.etat.value }}</td>
                        <td class="d-none d-sm-table-cell">{{ sortie.participants.contains(app.user) ? 'X' : '' }}</td>
                        <td  class="d-none d-sm-table-cell text-truncate" style="max-width: 150px;">
                            <a href="{{ path('profile_show', { id: sortie.organisateur.id }) }}">
                                {% if sortie.organisateur.pseudo %}
                                    {{ sortie.organisateur.pseudo }}
                                {% else %}
                                    {{ sortie.organisateur.nom | capitalize }} {{ sortie.organisateur.prenom | slice(0, 1) }}
                                    .
                                {% endif %}</a></td>
                        <td class="d-sm-none">{{ sortie.lieu.ville.nom | upper }}</td>
                        <td class="d-none d-sm-table-cell text-nowrap">
                            {% if sortie.etat.value == "creee" and sortie.organisateur == app.user %}
                                <a class="btn btn-primary btn-sm sortie-btn-icone"
                                   href="{{ path('sortie_detail', {id: sortie.id}) }}">
                                    <i class="bi bi-eye"></i>
                                    <span>Afficher</span>
                                </a>
                                <a class="btn btn-sm btn-warning sortie-btn-icone" href="{{ path('sortie_update', {id: sortie.id}) }}">
                                    <i class="bi bi-pencil"></i>
                                    <span>Modifier</span>
                                </a>
                                <form class="d-inline" method="post"
                                      action="{{ path('sortie_publication', {id: sortie.id}) }}">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('publication' ~ sortie.id) }}">
                                    <button class="btn btn-sm btn-success sortie-btn-icone" type="submit">
                                        <i class="bi bi-send"></i>
                                        <span>Publier</span>
                                    </button>
                                </form>

                            {% elseif sortie.etat.value in ["publiee", "cloturee"] %}
                                <a class="btn btn-primary btn-sm sortie-btn-icone"
                                   href="{{ path('sortie_detail', {id: sortie.id}) }}">
                                    <i class="bi bi-eye"></i>
                                    <span>Afficher</span>
                                </a>
                                {% if app.user %}
                                    {% if sortie.organisateur == app.user %}
                                        <a class="btn btn-sm btn-danger sortie-btn-icone" href="{{ path('sortie_annuler', {id: sortie.id}) }}">
                                            <i class="bi bi-x-circle"></i>
                                            <span>Annuler</span>
                                        </a>
                                    {% elseif sortie.participants.contains(app.user) %}
                                        <form class="d-inline" method="post"
                                              action="{{ path('sortie_desistement', {id: sortie.id}) }}">
                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('desistement' ~ sortie.id) }}">
                                            <button class="btn btn-sm btn-warning sortie-btn-icone" type="submit">
                                                <i class="bi bi-person-dash"></i>
                                                <span>Se désister</span>
                                            </button>                                        </form>
                                    {% elseif sortie.etat.value == "publiee" %}
                                        <form class="d-inline" method="post"
                                              action="{{ path('sortie_inscription', {id: sortie.id}) }}">
                                            <input type="hidden" name="_token"
                                                   value="{{ csrf_token('inscription' ~ sortie.id) }}">
                                            <button class="btn btn-sm btn-success sortie-btn-icone" type="submit">
                                                <i class="bi bi-person-plus"></i>
                                                <span>S'inscrire</span>
                                            </button>                                        </form>
                                    {% endif %}
                                {% endif %}

                            {% elseif sortie.etat.value in ["en_cours", "terminee", "annulee"] %}
                                <a class="btn btn-primary btn-sm sortie-btn-icone"
                                   href="{{ path('sortie_detail', {id: sortie.id}) }}">
                                    <i class="bi bi-eye"></i>
                                    <span>Afficher</span>
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                {% endif %}
            {% else %}
                <tr>
                    <td colspan="4">No records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</turbo-frame>
