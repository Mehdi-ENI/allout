{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/sortie.css') }}">
{% endblock %}


{% block body %}
    <div class="container">
        <div class="d-flex justify-content-between align-items-start">
            <div class="ms-auto text-end">
                <p class="mb-0 mt-3">Date du jour : {{ 'now' | date('d/m/y') }}</p>
                <p class="mb-0">Participant :
                    {% if app.user %}
                        {{ app.user.prenom | capitalize }} {{ app.user.nom | slice (0,1) }}.
                    {% else %}
                        Non connecté
                    {% endif %}
                </p>
            </div>
        </div>

        <h2>Filtrer les sorties</h2>

        <form action="{{ path('sortie_list') }}" method="get">
            <div class="row row-cols-auto mb-3">
                <label for="site" class="col col-form-label">Site :</label>
                <div class="col">
                    <select id="site" class="form-select form-select-sm" name="site"
                            data-turbo-frame="liste-sorties">
                        <option value="" {{ app.request.query.get('site') is empty ? 'selected' }}>Tous les
                            sites
                        </option>
                        {% for site in sites %}
                            <option
                                value="{{ site.nom }}" {{ app.request.query.get('site') == site.nom ? 'selected' }}>
                                {{ site.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="row ">
                <div class="col-lg-6 col-5 ">
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 mb-3">
                        <label for="nom" class="col-form-label text-nowrap">Le nom de la sortie contient :</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input id="nom" class="form-control form-control-sm" type="text" name="nom"
                                   placeholder="Rechercher" value="{{ app.request.query.get('nom') }}">
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                            <label for="date-debut" class="col-form-label text-nowrap">Entre</label>
                            <input id="date-debut" class="form-control form-control-sm flex-grow-1"
                                   type="datetime-local"
                                   name="date_debut" value="{{ app.request.query.get('date_debut') }}">
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                            <label for="date-fin" class="col-form-label text-nowrap">et</label>
                            <input id="date-fin" class="form-control form-control-sm flex-grow-1" type="datetime-local"
                                   name="date_fin" value="{{ app.request.query.get('date_fin') }}">
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-5">
                    <div class="form-check">
                        <input id="organisee" class="form-check-input" type="checkbox" name="sorties_organisees"
                               value="1"
                            {{ app.request.query.get('sorties_organisees') ? 'checked' }}>
                        <label for="organisee" class="form-check-label">Sorties dont je suis
                            l'organisateur/trice</label>
                    </div>
                    <div class="form-check">
                        <input id="inscrit" class="form-check-input" type="checkbox" name="sorties_inscrits" value="1"
                            {{ app.request.query.get('sorties_inscrits') ? 'checked' }}>
                        <label for="inscrit" class="form-check-label">Sorties auxquelles je suis inscrit/e</label>
                    </div>
                    <div class="form-check">
                        <input id="non-inscrit" class="form-check-input" type="checkbox" name="sorties_non_inscrits"
                               value="1"
                            {{ app.request.query.get('sorties_non_inscrits') ? 'checked' }}>
                        <label for="non-inscrit" class="form-check-label">Sorties auxquelles je ne suis pas
                            inscrit/e</label>
                    </div>
                    <div class="form-check">
                        <input id="passee" class="form-check-input" type="checkbox" name="sorties_passees" value="1"
                            {{ app.request.query.get('sorties_passees') ? 'checked' }}>
                        <label for="passee" class="form-check-label">Sorties passées</label>
                    </div>
                </div>
                <div class="col-lg-2 col-2">
                    <button class="btn btn-primary sortie-btn-icone" type="submit">
                        <i class="bi bi-search"></i>
                        <span>Rechercher</span>
                    </button>
                </div>
            </div>
        </form>

        <turbo-frame id="liste-sorties">
            {% include 'sortie/_list.html.twig' %}
        </turbo-frame>

        <a class="mt-3 mb-3 btn btn-primary" href="{{ path('sortie_create') }}">Créer une nouvelle sortie</a>
    </div>
{% endblock %}

