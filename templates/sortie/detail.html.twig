{% extends 'base.html.twig' %}

{% block title %}
    Détail sortie
{% endblock %}

{% block body %}

    <div class="container mt-5">

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">
                <h2 class="mb-0">{{ sortie.nom }}</h2>
            </div>

            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Date :</strong><br>
                        {{ sortie.dateHeureDebut|date('d/m/Y H:i') }}
                    </div>

                    <div class="col-md-6">
                        <strong>Date limite d'inscription :</strong><br>
                        {{ sortie.dateLimiteInscription|date('d/m/Y') }}
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Nombre max de participants :</strong><br>
                        {{ sortie.nbInscriptionsMax }}
                    </div>

                    <div class="col-md-6">
                        <strong>Etat :</strong><br>
                        {{ sortie.etat.label }}
                    </div>
                </div>

                <div class="mb-3">
                    <strong>Lieu :</strong><br>
                    {{ sortie.lieu.nom ~ ' - ' ~ sortie.lieu.rue ~ ' - ' ~ sortie.lieu.ville.nom ~ ' (' ~ sortie.lieu.ville.codePostal ~ ')' }}
                </div>

                <div class="mb-3">
                    <strong>Informations :</strong><br>
                    {% if sortie.infosSortie %}
                        {{ sortie.infosSortie }}
                    {% else %}
                        <span class="text-muted">
                        Aucune information complémentaire
                    </span>
                    {% endif %}
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Organisateur :</strong><br>
                    <a href="{{ path('profile_show', {id: sortie.organisateur.id}) }}">
                        {{ sortie.organisateur.nom }} {{ sortie.organisateur.prenom }}
                    </a>
                </div>

                <div class="col-md-6">
                    <strong>Participants ({{ sortie.participants|length }}) :</strong><br>
                    {% if sortie.participants|length > 0 %}
                        <ul class="list-unstyled mb-0">
                            {% for participant in sortie.participants %}
                                <li>
                                    <a href="{{ path('profile_show', {id: participant.id}) }}">
                                        {{ participant.nom }} {{ participant.prenom }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <span class="text-muted">Aucun participant inscrit</span>
                    {% endif %}
                </div>

            </div>

            <div class="card-footer text-end"
                {% if sortie.etat.value == "publiee" %}
                    {% if sortie.organisateur == app.user %}
                        <a class="btn btn-danger" href="">Annuler</a>
                    {% else %}
                        {% if sortie.participants.contains(app.user) %}
                            <a class="btn btn-warning" href="{{ path('sortie_desistement', {id: sortie.id}) }}">Se désister</a>
                        {% else %}
                            <a class="btn btn-primary" href="{{ path('sortie_inscription', {id: sortie.id}) }}">S'inscrire</a>
                        {% endif %}
                    {% endif %}
                {% endif %}

                {% if sortie.annulee %}
                    <div class="alert alert-danger">
                        <h5>Sortie annulée</h5>
                        <p>
                            <strong>Motif :</strong>
                            {{ sortie.motifAnnulation }}
                        </p>
                    </div>
                {% endif %}

                <form method="post" action="{{ path('sortie_delete', {id: sortie.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('suppression' ~ sortie.id) }}">
                    <button class="btn btn-warning" type="submit">Supprimer</button>
                </form>
                <a href="{{ path('sortie_list') }}"
                   class="btn btn-secondary">
                    Retour
                </a>

            </div>

        </div>

    </div>

{% endblock %}
