{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/ville.css') }}">
{% endblock %}

{% block title %}Gérer les villes{% endblock %}

{% block body %}
    <div class="container">

        <h2>Gérer les villes</h2>

        {# Formulaires d'édition hors tableau #}
        {% for ville in villes %}
            {{ form_start(formsEdit[ville.id], {'attr': {'id': 'form-edit-' ~ ville.id}}) }}
            {{ form_widget(formsEdit[ville.id]._token) }}
            {{ form_end(formsEdit[ville.id], {'render_rest': false}) }}
        {% endfor %}

        {# Formulaire d'ajout hors tableau #}
        {{ form_start(formNew, {'attr': {'id': 'form-ajout'}}) }}
        {{ form_widget(formNew._token) }}
        {{ form_end(formNew, {'render_rest': false}) }}

        <h5>Filtrer les villes</h5>
        <form class="mb-3" method="get" action="{{ path('app_ville_index') }}">
            <div class="row align-items-center">
                <div class="col-auto">
                    <label for="recherche" class="col-form-label">Le nom contient :</label>
                </div>
                <div class="col-auto">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" id="recherche" class="form-control form-control-sm"
                               name="recherche" placeholder="Rechercher" value="{{ recherche }}">
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-sm my-btn-icone">
                        <i class="bi bi-search"></i> <span>Rechercher</span>
                    </button>
                </div>
            </div>
        </form>

        <div class="border rounded p-3 overflow-x-auto">
            <table class="table table-hover" style="--bs-table-bg: transparent;">
                <thead>
                <tr style="--bs-table-bg: transparent;">
                    <th>Ville</th>
                    <th>Code postal</th>
                    <th style="width: 1%">Actions</th>
                </tr>
                </thead>
                <tbody class="table-group-divider">

                {# Ligne d'ajout épinglée en haut #}
                <tr>
                    <td>
                        {{ form_widget(formNew.nom, {
                            'attr': {'form': 'form-ajout', 'class': 'form-control form-control-sm', 'placeholder': 'Nouvelle ville'}
                        }) }}
                    </td>
                    <td>
                        {{ form_widget(formNew.codePostal, {
                            'attr': {'form': 'form-ajout', 'class': 'form-control form-control-sm', 'placeholder': 'Code postal'}
                        }) }}
                    </td>
                    <td class="text-nowrap">
                        <button type="submit" form="form-ajout" class="btn btn-success btn-sm my-btn-icone">
                            <i class="bi bi-plus-circle"></i> <span>Ajouter</span>
                        </button>
                    </td>
                </tr>

                {% for ville in villes %}
                    <tr id="ligne-{{ ville.id }}">
                        <td data-bs-toggle="tooltip" title="{{ ville.nom }}" class="text-truncate"
                            style="max-width: 150px;">
                            <span class="nom-texte">{{ ville.nom }}</span>
                            <span class="champ-edition" style="display:none;">
                                {{ form_widget(formsEdit[ville.id].nom, {
                                    'attr': {'form': 'form-edit-' ~ ville.id, 'class': 'form-control form-control-sm'}
                                }) }}
                            </span>
                        </td>
                        <td>
                            <span class="cp-texte">{{ ville.codePostal }}</span>
                            <span class="champ-edition" style="display:none;">
                                {{ form_widget(formsEdit[ville.id].codePostal, {
                                    'attr': {'form': 'form-edit-' ~ ville.id, 'class': 'form-control form-control-sm'}
                                }) }}
                            </span>
                        </td>
                        <td class="text-nowrap">
                            <span class="actions-affichage">
                                <a href="#" class="btn btn-warning btn-sm btn-modifier my-btn-icone"
                                   data-id="{{ ville.id }}">
                                    <i class="bi bi-pencil"></i> <span>Modifier</span>
                                </a>
                                <form method="post" action="{{ path('app_ville_delete', {'id': ville.id}) }}"
                                      class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ville.id) }}">
                                    <button type="submit" class="btn btn-danger btn-sm my-btn-icone"
                                            onclick="return confirm('Supprimer cette ville ?')">
                                        <i class="bi bi-trash"></i> <span>Supprimer</span>
                                    </button>
                                </form>
                            </span>
                            <span class="actions-edition" style="display:none;">
                                <button type="submit" form="form-edit-{{ ville.id }}"
                                        class="btn btn-success btn-sm my-btn-icone">
                                    <i class="bi bi-check-lg"></i> <span>Enregistrer</span>
                                </button>
                                <a href="#" class="btn btn-secondary btn-sm btn-annuler my-btn-icone"
                                   data-id="{{ ville.id }}">
                                    <i class="bi bi-x-lg"></i> <span>Annuler</span>
                                </a>
                            </span>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">Aucun résultat trouvé</td>
                    </tr>
                {% endfor %}

                </tbody>
            </table>
        </div>

    </div>

    <script>
        document.querySelectorAll('.btn-modifier').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const id = this.dataset.id;
                const ligne = document.getElementById('ligne-' + id);
                ligne.querySelectorAll('.nom-texte, .cp-texte').forEach(el => el.style.display = 'none');
                ligne.querySelectorAll('.champ-edition').forEach(el => el.style.display = 'inline');
                ligne.querySelector('.actions-affichage').style.display = 'none';
                ligne.querySelector('.actions-edition').style.display = 'inline';
            });
        });

        document.querySelectorAll('.btn-annuler').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const id = this.dataset.id;
                const ligne = document.getElementById('ligne-' + id);
                ligne.querySelectorAll('.nom-texte, .cp-texte').forEach(el => el.style.display = 'inline');
                ligne.querySelectorAll('.champ-edition').forEach(el => el.style.display = 'none');
                ligne.querySelector('.actions-affichage').style.display = 'inline';
                ligne.querySelector('.actions-edition').style.display = 'none';
            });
        });
    </script>
{% endblock %}
