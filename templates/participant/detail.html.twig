{% extends 'base.html.twig' %}

{% block body %}
<h1>Profil de {{ participant.prenom }} {{ participant.nom }}</h1>
<section>
    <article>
        <div>
            {% if participant.pseudo %}
                <p>Pseudo : {{ participant.pseudo }}</p>
            {% endif %}
            <p>E-Mail : {{ participant.email }}</p>
            <p> Telephone : {{ participant.telephone }}</p>
            <ul>Rôles :
                {% for role in participant.roles %}
                    <li>{{ role }}</li>
                {% endfor %}
            </ul>
            <a class="btn btn-primary" href="{{ path('participant_update', {'id': participant.id}) }}">Update Profil</a>
        </div>
    </article>
</section>
{% endblock %}

