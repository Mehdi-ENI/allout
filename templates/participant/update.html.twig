{% extends 'base.html.twig' %}
{% block body %}
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-11">
                <div class="card shadow-sm">
                    <div class="card-header bg-warning">
                        <h2 class="mb-0">Modifier un profil</h2>
                    </div>
                    <div class="card-body">
                        {{ form_errors(updateForm) }}
                        {{ form_start(updateForm, {'attr': {'novalidate': 'novalidate'}}) }}
                        {{ form_row(updateForm.prenom) }}
                        {{ form_row(updateForm.nom) }}
                        {{ form_row(updateForm.pseudo) }}
                        {{ form_row(updateForm.telephone) }}
                        {{ form_row(updateForm.email) }}
                        {{ form_row(updateForm.site) }}

                        {% if "ROLE_ADMIN" in app.user.roles %}
                            {{ form_row(updateForm.roles) }}
                        {% else %}
                            <div style="display:none;">
                                {{ form_row(updateForm.roles) }}
                            </div>
                        {% endif %}

                        {% if participant.image %}
                            <div class="mt-3 mb-2 text-center">
                                <p>Current image :</p>
                                <img src="{{ asset('img/' ~ participant.image) }}"
                                     alt="Current image"
                                     style="max-width:150px; height:auto; border-radius:50%;">
                            </div>
                        {% endif %}
                        {{ form_row(updateForm.image) }}
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <a href="{{ path(is_granted('ROLE_ADMIN') ? 'participant_list' : 'profile_show') }}" class="btn btn-secondary my-btn-icone">
                                <i class="bi bi-arrow-left-square"></i> <span>Annuler</span>
                            </a>
                            <button type="submit" class="btn btn-warning my-btn-icone">
                                <i class="bi bi-pencil"></i> <span>Modifier</span>
                            </button>
                        </div>
                        {{ form_end(updateForm) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

