{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
            <h2 class="mb-0">Participants</h2>
            <a class="btn my-btn-icone btn-success" href="{{ path('app_register') }}">
                <i class="bi bi-person-plus"></i>
                <span>Ajouter un participant</span>
            </a>
        </div>

        <div class="border rounded p-3 overflow-x-auto">
            <table class="table table-hover" style="--bs-table-bg: transparent;">
                <thead>
                <tr style="--bs-table-bg: transparent;">
                    <th scope="col">Nom</th>
                    <th scope="col">Prénom</th>
                    <th scope="col">E-Mail</th>
                    <th scope="col">Téléphone</th>
                    <th scope="col">État</th>
                    <th scope="col" style="width: 1%">Actions</th>
                </tr>
                </thead>
                <tbody class="table-group-divider">
                {% for participant in participants %}
                    <tr>
                        <td class="text-truncate" style="max-width: 150px;">
                            <a href="{{ path('profile_show', {'id': participant.id}) }}">
                                {{ participant.prenom }} {{ participant.nom | slice(0,1) }}.
                            </a>
                        </td>
                        <td>{{ participant.prenom }}</td>
                        <td>{{ participant.email }}</td>
                        <td>{{ participant.telephone }}</td>
                        <td>
                            {% if participant.actif %}
                                <span class="badge text-bg-success">Actif</span>
                            {% else %}
                                <span class="badge text-bg-secondary">Désactivé</span>
                            {% endif %}
                        </td>
                        <td class="text-nowrap">
                            <a class="btn btn-primary btn-sm my-btn-icone"
                               href="{{ path('profile_show', {'id': participant.id}) }}">
                                <i class="bi bi-eye"></i>
                                <span>Afficher</span>
                            </a>
                            {% if participant.actif %}
                                <a class="btn btn-warning btn-sm my-btn-icone"
                                   href="{{ path('participant_desactivate', {'id': participant.id}) }}">
                                    <i class="bi bi-person-slash"></i>
                                    <span>Désactiver</span>
                                </a>
                            {% else %}
                                <a class="btn btn-success btn-sm my-btn-icone"
                                   href="{{ path('participant_activate', {'id': participant.id}) }}">
                                    <i class="bi bi-person-check"></i>
                                    <span>Activer</span>
                                </a>
                            {% endif %}
                            <a class="btn btn-danger btn-sm my-btn-icone"
                               href="{{ path('participant_delete', {'id': participant.id}) }}"
                               onclick="return confirm('Supprimer {{ participant.prenom }} {{ participant.nom }} ?')">
                                <i class="bi bi-trash"></i>
                                <span>Supprimer</span>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">Aucun participant trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
