{% extends 'base.html.twig' %}

{% block body %}
    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>E-Mail</th>
            <th>Téléphone</th>
            <th>Actif</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for participant in participants %}
            <tr>
                <td>{{ participant.id }}</td>
                <td>{{ participant.nom }}</td>
                <td>{{ participant.prenom}}</td>
                <td>{{ participant.email}}</td>
                <td>{{ participant.telephone}}</td>
                {% if participant.actif == true %}
                    <td>Actif</td>
                {% else %}
                    <td>Désactivé</td>
                {% endif %}
                                <td>
                                   <a class="btn btn-danger href="{{ path('participant_delete', {'id': participant.id}) }}">Delete</a>
                                   <a class="btn btn-primary href="{{ path('participant_detail', {'id': participant.id}) }}">edit</a>
                               </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">No partcipants found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}


