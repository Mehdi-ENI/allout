{% extends 'base.html.twig' %}

{% block title %}Créer un participant{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-11">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h2 class="mb-0">Ajouter un participant</h2>
                    </div>
                    <div class="card-body">
                        {% if registrationForm.vars.errors|length > 0 %}
                            <div class="alert alert-danger">
                                {{ form_errors(registrationForm) }}
                            </div>
                        {% endif %}

                        {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="mb-3">
                            {{ form_label(registrationForm.prenom, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(registrationForm.prenom, {'attr': {'class': 'form-control' ~ (registrationForm.prenom.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            {% if registrationForm.prenom.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in registrationForm.prenom.vars.errors %}{{ error.message }}{% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.nom, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(registrationForm.nom, {'attr': {'class': 'form-control' ~ (registrationForm.nom.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            {% if registrationForm.nom.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in registrationForm.nom.vars.errors %}{{ error.message }}{% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.pseudo, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(registrationForm.pseudo, {'attr': {'class': 'form-control' ~ (registrationForm.pseudo.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            {% if registrationForm.pseudo.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in registrationForm.pseudo.vars.errors %}{{ error.message }}{% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.telephone, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(registrationForm.telephone, {'attr': {'class': 'form-control' ~ (registrationForm.telephone.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            {% if registrationForm.telephone.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in registrationForm.telephone.vars.errors %}{{ error.message }}{% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control' ~ (registrationForm.email.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            {% if registrationForm.email.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in registrationForm.email.vars.errors %}{{ error.message }}{% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.site, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(registrationForm.site, {'attr': {'class': 'form-control' ~ (registrationForm.site.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            {% if registrationForm.site.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in registrationForm.site.vars.errors %}{{ error.message }}{% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        {# Mot de passe — les erreurs de contraintes remontent sur first.vars.errors #}
                        <div class="mb-3">
                            {{ form_label(registrationForm.plainPassword.first, 'Mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(registrationForm.plainPassword.first, {'attr': {
                                'class': 'form-control' ~ (registrationForm.plainPassword.first.vars.errors|length > 0 ? ' is-invalid' : '')
                            }}) }}
                            {% if registrationForm.plainPassword.first.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in registrationForm.plainPassword.first.vars.errors %}{{ error.message }}{% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        {# Confirmation — l'erreur de non-correspondance remonte sur le parent plainPassword #}
                        <div class="mb-3">
                            {{ form_label(registrationForm.plainPassword.second, 'Confirmer le mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(registrationForm.plainPassword.second, {'attr': {
                                'class': 'form-control' ~ (registrationForm.plainPassword.vars.errors|length > 0 ? ' is-invalid' : '')
                            }}) }}
                            {% if registrationForm.plainPassword.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in registrationForm.plainPassword.vars.errors %}{{ error.message }}{% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            {{ form_label(registrationForm.image, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(registrationForm.image, {'attr': {'class': 'form-control' ~ (registrationForm.image.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            {% if registrationForm.image.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in registrationForm.image.vars.errors %}{{ error.message }}{% endfor %}
                                </div>
                            {% endif %}
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <a href="{{ path('participant_list') }}" class="btn btn-secondary my-btn-icone">
                                <i class="bi bi-arrow-left-square"></i> <span>Annuler</span>
                            </a>
                            <button type="submit" class="btn btn-success my-btn-icone">
                                <i class="bi bi-plus-circle"></i> <span>Enregistrer</span>
                            </button>
                        </div>

                        {{ form_end(registrationForm) }}

                    </div>
                </div>

            </div>
        </div>
    </div>
{% endblock %}
